{
    "name": "jerryxf",
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@11.17.0",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.17.0",
            "onFail": "download"
        }
    },
    "scripts": {
        "dev": "vite --host",
        "build": "tsc -b && vite build",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 8",
        "lint:fix": "eslint . --report-unused-disable-directives --fix",
        "type-check": "tsc --noEmit",
        "preview": "vite preview",
        "analyze": "pnpm run build && npx vite-bundle-analyzer"
    },
    "dependencies": {
        "@fontsource-variable/outfit": "^5.2.8",
        "@gsap/react": "^2.1.2",
        "baffle": "^0.3.6",
        "d3": "^7.9.0",
        "gsap": "^3.15.0",
        "lucide-react": "^1.14.0",
        "motion": "^12.38.0",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-helmet-async": "^3.0.0",
        "split-type": "^0.3.4",
        "wouter": "^3.10.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/d3": "^7.4.3",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.58.2",
        "@typescript-eslint/parser": "^8.58.2",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^9.7.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "sass": "^1.99.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.59.4",
        "vite": "^8.0.16",
        "vite-plugin-pwa": "^1.3.0"
    }
}
