{
    "name": "jerryxf",
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@11.24.0",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.24.0",
            "onFail": "download"
        }
    },
    "scripts": {
        "dev": "vite --host",
        "build": "tsc -b && vite build",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 8",
        "lint:fix": "eslint . --report-unused-disable-directives --fix",
        "type-check": "tsc -b --noEmit",
        "preview": "vite preview",
        "analyze": "pnpm run build && npx vite-bundle-analyzer"
    },
    "dependencies": {
        "@fontsource-variable/outfit": "^5.3.0",
        "@gsap/react": "^2.1.2",
        "baffle": "^0.3.6",
        "d3": "^7.9.0",
        "gsap": "^3.15.0",
        "lucide-react": "^1.27.0",
        "motion": "^12.42.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-helmet-async": "^3.0.0",
        "split-type": "^0.3.4",
        "wouter": "^3.10.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@mdx-js/rollup": "^3.1.1",
        "@shikijs/rehype": "^4.4.3",
        "@types/d3": "^7.4.3",
        "@types/mdx": "^2.0.14",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.8.0",
        "katex": "^0.18.4",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-katex": "^7.0.1",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "sass": "^1.102.0",
        "shiki": "^4.4.3",
        "typescript": "npm:@typescript/typescript6@^6.0.0",
        "typescript-7": "npm:typescript@^7.0.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vite-plugin-pwa": "^1.3.0"
    }
}
